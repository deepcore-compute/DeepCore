install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
CPackConfig.cmake
CPackSourceConfig.cmake
*.cmake.bak

# ----- Object files, libraries, executables ------------------------------
*.o
*.obj
*.lo
*.slo
*.a
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.out
*.app
*.exp
*.ilk

# ----- Debug symbols and PDBs --------------------------------------------
